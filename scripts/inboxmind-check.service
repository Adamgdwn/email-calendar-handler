# InboxMind hourly CRITICAL-mail check — systemd user service.
# Do not edit this file directly; run scripts/install-check-timer.sh to
# (re-)install with the correct paths for the current machine.
#
# The installed copy lives at ~/.config/systemd/user/inboxmind-check.service
# with @REPO@ and @UV@ expanded to absolute paths.
[Unit]
Description=InboxMind hourly CRITICAL mail check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@
ExecStart="@REPO@/scripts/inboxmind-app.sh" check
StandardOutput=journal
StandardError=journal
