ANTHROPIC_API_KEY=
# Required for `inboxmind sync`; create the project and apply supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
# Device-code flow (default) needs no client secret or redirect URI; set these
# only for the authorization-code fallback flow.
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Fernet key for local encryption at rest. Generate one with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY_BASE64=
# Optional: directory for the encrypted token cache and consent log (default ~/.inboxmind)
INBOXMIND_HOME=
INBOXMIND_ENV=dev
