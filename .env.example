ANTHROPIC_API_KEY=
# Required for `inboxmind sync`; create the project and apply supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
# Device-code flow (default) needs no client secret or redirect URI; set these
# only for the authorization-code fallback flow.
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Fernet key for local encryption at rest. Generate one with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY_BASE64=
# Optional: directory for the encrypted token cache and consent log (default ~/.inboxmind)
INBOXMIND_HOME=
INBOXMIND_ENV=dev
# Multi-account: comma-separated aliases matching `inboxmind connect --account <alias>` runs.
# Leave unset for single-account setup. Example: INBOXMIND_ACCOUNTS=guided_ai_labs,red_deer,shaw
INBOXMIND_ACCOUNTS=
# LLM classification assist — off by default; requires explicit opt-in.
# When enabled, emails classified below LLM_ASSIST_CONFIDENCE_THRESHOLD trigger
# one Anthropic call. A per-day token budget caps spend (default 10 000 tokens).
LLM_ASSIST_ENABLED=false
LLM_ASSIST_CONFIDENCE_THRESHOLD=0.6
LLM_ASSIST_DAILY_TOKEN_BUDGET=10000
